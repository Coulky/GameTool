# Auto detect text files and perform LF normalization
* text=auto

# Source code files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.md text eol=lf

# Binary files
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdb binary